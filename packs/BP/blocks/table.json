{
  "format_version": "1.21.90",
  "minecraft:block": {
    "description": {
      "identifier": "kochmod:table",
      "menu_category": {
        "category": "construction"
      },
      "states": {
        "kochmod:plate": ["none", "hamburger", "cheeseburger", "failed_dish", "empty"]
      }
    },
    "components": {
      "minecraft:geometry": {
        "identifier": "geometry.kochmod.table",
        "bone_visibility": {
          "plate": "q.block_state('kochmod:plate') == 'hamburger' || q.block_state('kochmod:plate') == 'cheeseburger' || q.block_state('kochmod:plate') == 'failed_dish'",
          "plate_empty": "q.block_state('kochmod:plate') == 'empty'",
          "hamburger": "q.block_state('kochmod:plate') == 'hamburger'",
          "cheeseburger": "q.block_state('kochmod:plate') == 'cheeseburger'",
          "failed_dish": "q.block_state('kochmod:plate') == 'failed_dish'"
        }
      },
      "minecraft:material_instances": {
        "*": {
          "texture": "kochmod_table",
          "render_method": "alpha_test"
        }
      },
      "minecraft:collision_box": {
        "origin": [-8, 0, -8],
        "size": [16, 16, 16]
      },
      "minecraft:selection_box": {
        "origin": [-8, 0, -8],
        "size": [16, 16, 16]
      },
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 0.5
      },
      "minecraft:light_dampening": 0,
      "minecraft:map_color": "#c28a52",
      "kochmod:table": {}
    }
  }
}
