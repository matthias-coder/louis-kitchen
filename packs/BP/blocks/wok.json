{
  "format_version": "1.21.90",
  "minecraft:block": {
    "description": {
      "identifier": "kochmod:wok",
      "menu_category": {
        "category": "construction"
      },
      "states": {
        "kochmod:state": ["empty", "raw", "cooking", "done", "burnt"]
      }
    },
    "components": {
      "minecraft:geometry": {
        "identifier": "geometry.kochmod.wok",
        "bone_visibility": {
          "contents_raw": "q.block_state('kochmod:state') == 'raw'",
          "contents_cooking": "q.block_state('kochmod:state') == 'cooking'",
          "contents_done": "q.block_state('kochmod:state') == 'done'",
          "contents_burnt": "q.block_state('kochmod:state') == 'burnt'",
          "steam": "q.block_state('kochmod:state') == 'cooking' || q.block_state('kochmod:state') == 'done'"
        }
      },
      "minecraft:material_instances": {
        "*": {
          "texture": "kochmod_wok",
          "render_method": "alpha_test"
        }
      },
      "minecraft:collision_box": {
        "origin": [-8, 0, -8],
        "size": [16, 16, 16]
      },
      "minecraft:selection_box": {
        "origin": [-8, 0, -8],
        "size": [16, 16, 16]
      },
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 0.5
      },
      "minecraft:light_dampening": 0,
      "minecraft:map_color": "#1e1f22",
      "kochmod:wok": {}
    }
  }
}
