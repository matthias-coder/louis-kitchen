{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.kochmod.guest": {
      "geometry": "Geometry.default",
      "materials": [{ "*": "Material.default" }],
      "textures": ["Texture.default"],
      "part_visibility": [
        { "*": true },
        { "bubble": "q.property('kochmod:wish') != 'none'" },
        { "bubble_hamburger": "q.property('kochmod:wish') == 'hamburger'" },
        { "bubble_cheeseburger": "q.property('kochmod:wish') == 'cheeseburger'" },
        { "bubble_pizza_margherita": "q.property('kochmod:wish') == 'pizza_margherita'" },
        { "bubble_salami_pizza": "q.property('kochmod:wish') == 'salami_pizza'" },
        { "bubble_ramen": "q.property('kochmod:wish') == 'ramen'" },
        { "bubble_potato_soup": "q.property('kochmod:wish') == 'potato_soup'" },
        { "bubble_doner": "q.property('kochmod:wish') == 'doner'" },
        { "bubble_sushi": "q.property('kochmod:wish') == 'sushi'" },
        { "bubble_fried_noodles": "q.property('kochmod:wish') == 'fried_noodles'" },
        { "bubble_fries": "q.property('kochmod:wish') == 'fries'" }
      ]
    }
  }
}
